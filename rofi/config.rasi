configuration {
    modes:                "drun,run,window";
    show-icons:           true;
    icon-theme:           "Papirus-Dark";
    display-drun:         "";
    display-run:          "";
    display-window:       "";
    drun-display-format:  "{name}";
    terminal:             "kitty";
    sort:                 true;
    sorting-method:       "fzf";
    matching:             "fuzzy";
    case-smart:           true;
    cycle:                true;
    hover-select:         false;

    /* Keybindings are rofi defaults — arrows, Enter and Escape as before. */

    timeout {
        action: "kb-cancel";
        delay:  0;
    }

    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
}

@theme "~/.config/rofi/theme.rasi"
